              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyAddress\": {\n    \"street\": \"<string>\",\n    \"city\": \"<string>\",\n    \"state\": \"<string>\",\n    \"zipCode\": \"<string>\"\n  },\n  \"tenantInfo\": {\n    \"firstName\": \"<string>\",\n    \"lastName\": \"<string>\",\n    \"dateOfBirth\": \"<date>\",\n    \"email\": \"<email>\",\n    \"phone\": \"<string>\"\n  },\n  \"coverageOptions\": {\n    \"personalPropertyLimit\": \"<integer>\",\n    \"liabilityLimit\": \"<integer>\",\n    \"medicalPaymentsLimit\": \"<integer>\",\n    \"deductible\": \"<integer>\",\n    \"additionalLivingExpenses\": \"<boolean>\",\n    \"identityRestorationCoverage\": \"<boolean>\"\n  },\n  \"effectiveDate\": \"<date>\"\n}",
